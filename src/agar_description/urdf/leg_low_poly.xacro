<?xml version="1.0"?>
<robot name="agar" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="leg_low_poly" params="name type xyz rpy ixyz irpy ixx ixy ixz iyy iyz izz jxyz jrpy">
        <link name="${name}">
            <visual>
                <origin xyz="${xyz}" rpy="${rpy}" />
                <geometry>
                     <box size="0.8 0.06 0.08" />
                </geometry>
                <material name="grey" />
            </visual>
            <inertial>
                <origin xyz="${ixyz}" rpy="${irpy}" />
                <mass value="55.56" />
                <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
            </inertial>
            <collision>
                <origin xyz="${xyz}" rpy="${rpy}" />
                <geometry>
                     <box size="0.8 0.06 0.08" />
                </geometry>
            </collision>
        </link>
        <joint name="${name}_joint" type="fixed">
            <origin xyz="${jxyz}" rpy="${jrpy}" />
            <parent link="${name}_fixture" />
            <child link="${name}" />
        </joint>
        <gazebo reference="${name}">
            <material>Gazebo/Grey</material>
        </gazebo>
    </xacro:macro>
</robot>   