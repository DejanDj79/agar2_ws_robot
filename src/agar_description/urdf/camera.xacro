<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="depth_camera">
        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.03 0.163 0.037" />
            </geometry>
            <material name="black" />
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
    </link>
    <joint name="depth_camera_joint" type="fixed">
        <origin xyz="0 0 -0.025" rpy="0 0 0" />
        <parent link="top_stand" />
        <child link="depth_camera"/>
    </joint>
    <gazebo reference="depth_camera">
        <material>Gazebo/Black</material>
    </gazebo>


    <link name="depth_camera_frame">
        <visual>
            <origin xyz="${pi/2} 0 ${pi/2}" />
            <geometry>
                <box size="0.001 0.001 0.001" />
            </geometry>
            <material name="black" />
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
    </link>
    <joint name="depth_camera_frame_joint" type="fixed">
        <origin xyz="0 0 -0.025" rpy="${-pi/2} 0 ${-pi/2}" />
        <parent link="top_stand" />
        <child link="depth_camera_frame"/>
    </joint>


    <gazebo reference="depth_camera">
        <sensor name="camera" type="depth">
            <visualize>true</visualize>
            <update_rate>20.0</update_rate>
            <camera name="depth_camera">
                <horizontal_fov>1.919862</horizontal_fov>
                <image>
                    <width>800</width>
                    <height>600</height>
                    <format>B8G8R8</format>
                </image>
                <clip>
                    <near>0.8</near>
                    <far>100.0</far>
                </clip>
                <!-- <noise>
                    <type>gaussian</type>
                    <mean>0.5</mean>
                    <stddev>1.0</stddev>
                </noise> -->
            </camera>
            <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
                <baseline>0.1</baseline>
                <alwaysOn>true</alwaysOn>
                <updateRate>0.0</updateRate>
                <frame_name>depth_camera_frame</frame_name>
                <pointCloudCutoff>0.4</pointCloudCutoff>
                <!-- <pointCloudCutoffMax>50.0</pointCloudCutoffMax>
                <distortionK1>0</distortionK1>
                <distortionK2>0</distortionK2>
                <distortionK3>0</distortionK3>
                <distortionT1>0</distortionT1>
                <distortionT2>0</distortionT2>
                <CxPrime>0</CxPrime>
                <Cx>0</Cx>
                <Cy>0</Cy>
                <focalLength>0</focalLength>
                <hackBaseline>0</hackBaseline> -->
            </plugin>
        </sensor>
    </gazebo>



</robot>