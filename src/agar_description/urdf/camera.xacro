<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="rgbd_camera_link" />
    <joint name="rgbd_camera_link_joint" type="fixed">
        <parent link="top_stand" />
        <child link="rgbd_camera_link" />
        <origin xyz="0.60 0 -0.05" rpy="0 0 0" />
    </joint> 
    <gazebo reference="rgbd_camera_link">
        <sensor name="camera_sensor_rgbd" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>10.0</update_rate>
            <visualize>false</visualize>
            <camera name="rgbd_camera">
                <horizontal_fov>1.0547</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                    <!-- <format>R8G8B8</format> -->
                </image>
                <clip>
                    <near>0.3</near>
                    <far>30</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </camera>
            <frame_name>rgbd_camera_frame</frame_name>
            <frame_id>rgbd_camera_link</frame_id>
            <topic>camera/rgbd/image_raw</topic>
            <ignition_frame_id>rgbd_camera_link</ignition_frame_id>
        </sensor>
    </gazebo>
</robot>