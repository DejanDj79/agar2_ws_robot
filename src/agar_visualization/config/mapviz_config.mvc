capture_directory: "~"
fixed_frame: map
target_frame: odom
fix_orientation: true
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1864
window_height: 1016
view_scale: 0.0447299443
offset_x: 16.1872559
offset_y: -4.56953907
use_latest_transforms: true
background: "#a0a0a4"
image_transport: raw
displays:
  - type: mapviz_plugins/tile_map
    name: new display
    config:
      visible: true
      collapsed: false
      custom_sources:
        []
      bing_api_key: Av63clFa5mA5qnuu8Y4wl-7kohbJ-AJH0SMLmyvvUJcuTqtS9J6bvAduxh_8dO0S
      source: Bing Maps (terrain)
  - type: mapviz_plugins/robot_image
    name: new display
    config:
      visible: true
      collapsed: true
      frame: base_footprint
      image: /home/nikolica/Downloads/agar_top.png
      width: 2
      height: 1.3200000000000001
      offset_x: 0
      offset_y: 0
      ratio: original
  - type: mapviz_plugins/navsat
    name: new display
    config:
      visible: true
      collapsed: true
      topic: /gps/fix
      color: "#00ff00"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/navsat
    name: new display
    config:
      visible: true
      collapsed: true
      topic: /gps/fix/left
      color: "#f9f06b"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/navsat
    name: new display
    config:
      visible: true
      collapsed: true
      topic: /gps/fix/right
      color: "#f9f06b"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/odometry
    name: new display
    config:
      visible: true
      collapsed: true
      topic: /odometry/filtered
      color: "#c80003"
      draw_style: arrows
      position_tolerance: 0.69999999999999996
      buffer_size: 0
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 6
      show_timestamps: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/tf_frame
    name: new display
    config:
      visible: true
      collapsed: true
      frame: base_footprint
      color: "#99c1f1"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
      static_arrow_sizes: false
      arrow_size: 25
  - type: mapviz_plugins/path
    name: new display
    config:
      visible: true
      collapsed: true
      topic: /plan
      color: "#dc8add"
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2